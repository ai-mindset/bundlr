#+feature dynamic-literals
package main

import b "../src"
import t "../tests"
import "core:compress/deflate"
import "core:encoding/json"
import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"
import "core:time"

prepared_uv :: proc() -> (compressed: []u8, record: b.Provenance, failure: Error) {
    metadata := t.read_bytes("vendor/uv/provenance.json") or_return
    if json.unmarshal(metadata, &record) != nil || record.version != b.UV_VERSION || record.target != b.host_target() || record.manifestSha256 != b.UV_MANIFEST_SHA {
        return nil, record, "Prepare uv for this native host first."
    }
    compressed = t.read_bytes("vendor/uv/uv.gz") or_return
    binary: [dynamic]u8
    if deflate.inflate_gzip(&binary, compressed, max_output_size = 128*1024*1024) != nil || b.bytes_hash(binary[:]) != record.executableSha256 {
        return nil, record, "Prepared compressed uv failed SHA-256 verification."
    }
    name := "uv.exe" when ODIN_OS == .Windows else "uv"
    if !b.matches_hash(b.join("vendor", "uv", name), record.executableSha256) { return nil, record, "Prepared uv executable failed SHA-256 verification." }
    return compressed, record, nil
}
prepare_uv :: proc(prepared: bool) -> Error {
    if prepared {
        _, record := prepared_uv() or_return
        fmt.println(b.json_text(record))
        return nil
    }
    if e := b.mkdir("vendor/uv"); e != nil { return e }
    stage := t.temporary("vendor/uv", ".prepare-") or_return
    defer os.remove_all(stage)
    base := fmt.aprintf("https://github.com/astral-sh/uv/releases/download/%s", b.UV_VERSION)
    manifest := b.join(stage, "sha256.sum")
    if e := b.download(nil, fmt.aprintf("%s/sha256.sum", base), manifest); e != nil { return e }
    if !b.matches_hash(manifest, b.UV_MANIFEST_SHA) { return "uv checksum manifest failed SHA-256 verification." }
    triples := map[string]string{"linux-x86_64" = "x86_64-unknown-linux-gnu", "macos-arm64" = "aarch64-apple-darwin", "macos-x86_64" = "x86_64-apple-darwin", "windows-x86_64" = "x86_64-pc-windows-msvc"}
    extension := ".zip" when ODIN_OS == .Windows else ".tar.gz"
    name := fmt.aprintf("uv-%s%s", triples[b.host_target()], extension)
    expected := ""
    contents := b.text(manifest) or_return
    for line in strings.split_lines(contents) {
        fields := strings.fields(line)
        if len(fields) == 2 && strings.trim_left(fields[1], "*") == name { expected = fields[0] }
    }
    if len(expected) != 64 { return "Missing uv archive checksum." }
    archive := b.join(stage, name)
    if e := b.download(nil, fmt.aprintf("%s/%s", base, name), archive); e != nil { return e }
    if !b.matches_hash(archive, expected) { return "uv archive failed SHA-256 verification." }
    executable_name := "uv.exe" when ODIN_OS == .Windows else "uv"
    executable: []u8
    when ODIN_OS == .Windows {
        data := t.read_bytes(archive) or_return
        entries := t.read_zip(data) or_return
        for entry in entries {
            if filepath.base(entry.name) == executable_name {
                if executable != nil { return "Ambiguous uv executable." }
                executable = entry.data
            }
        }
    } else {
        listing, stderr, listing_error := t.capture([]string{"tar", "-tzf", archive})
        if listing_error != nil { return fmt.aprintf("Cannot inspect uv archive: %s", stderr) }
        member := ""
        for entry in strings.split_lines(listing) {
            if filepath.base(entry) == executable_name {
                if member != "" || !t.safe_path(entry) { return "Ambiguous or unsafe uv archive entry." }
                member = entry
            }
        }
        if member == "" { return "Missing uv executable." }
        if e := t.command([]string{"tar", "-xzf", archive, "-C", stage, member}); e != nil { return e }
        path := b.join(stage, member)
        info, stat_error := os.lstat(path, context.allocator)
        if stat_error != nil || info.type != .Regular { return "uv archive member is not a regular file." }
        executable = t.read_bytes(path) or_return
    }
    if len(executable) == 0 { return "Missing uv executable." }
    compressed: [dynamic]u8
    if deflate.deflate_gzip(&compressed, executable, .Best) != nil { return "Cannot compress verified uv." }
    record := b.Provenance{b.UV_VERSION, b.host_target(), b.bytes_hash(executable), b.UV_MANIFEST_SHA}
    // Stage all generated bytes before replacing the prepared payload.
    binary := b.join(stage, "verified-uv")
    if e := b.write_bytes(binary, executable, os.perm_number(0o755)); e != nil { return e }
    gzip := b.join(stage, "uv.gz")
    if e := b.write_bytes(gzip, compressed[:]); e != nil { return e }
    metadata := b.join(stage, "provenance.json")
    if e := b.write_text(metadata, fmt.aprintf("%s\n", b.json_text(record))); e != nil { return e }
    for source, i in ([3]string{binary, gzip, metadata}) {
        destinations := [3]string{executable_name, "uv.gz", "provenance.json"}
        if os.rename(source, b.join("vendor", "uv", destinations[i])) != nil { return "Cannot publish prepared uv payload." }
    }
    fmt.println(b.json_text(record))
    return nil
}
Build_Record :: struct {
    target, compilerRevision: string,
    arguments: []string,
    executableBytes: int,
    executableMiB: f64,
    compressedUvBytes: int,
    sha256: string,
    compileSeconds: f64,
    validation: string,
}
build :: proc(requested: string) -> Error {
    output := b.absolute_path(requested) or_return
    destinations := [3]string{output, fmt.aprintf("%s.json", output), fmt.aprintf("%s.sha256", output)}
    for path in destinations { if e := b.absent(path); e != nil { return e } }
    odin := compiler() or_return
    compressed, _ := prepared_uv() or_return
    if e := b.mkdir(filepath.dir(output)); e != nil { return e }
    stage := t.temporary(filepath.dir(output), ".bundlr-compile-") or_return
    defer os.remove_all(stage)
    candidate := b.join(stage, "bundlr.exe" when ODIN_OS == .Windows else "bundlr")
    args := []string{odin, "build", "src", "-o:speed", "-vet", "-strict-style", fmt.aprintf("-out:%s", candidate)}
    started := time.tick_now()
    if e := t.command(args); e != nil { return e }
    seconds := time.duration_seconds(time.tick_since(started))
    env := t.environment(map[string]string{"PATH" = "", "BUNDLR_CACHE_DIRECTORY" = b.join(stage, "cache")}, []string{"BUNDLR_UV_EXECUTABLE"})
    for option in ([2]string{"--help", "--diagnose"}) { if e := t.command([]string{candidate, option}, env); e != nil { return e } }
    contents := t.read_bytes(candidate) or_return
    args[len(args)-1] = fmt.aprintf("-out:%s", output)
    record := Build_Record{b.host_target(), COMPILER_VERSION, args[1:], len(contents), f64(len(contents))/(1024*1024), len(compressed), b.bytes_hash(contents), seconds, "help and offline diagnostic passed; full acceptance required before release"}
    metadata, checksum := b.join(stage, "build.json"), b.join(stage, "checksum")
    if e := b.write_text(metadata, fmt.aprintf("%s\n", b.json_text(record))); e != nil { return e }
    if e := b.write_text(checksum, fmt.aprintf("%s  %s\n", record.sha256, filepath.base(output))); e != nil { return e }
    published := 0
    committed := false
    defer { if !committed { for i in 0..<published { _ = os.remove(destinations[i]) } } }
    for source, i in ([3]string{candidate, metadata, checksum}) {
        if os.link(source, destinations[i]) != nil { return "Refusing to overwrite completed build output." }
        published += 1
    }
    committed = true
    fmt.println(b.json_text(record))
    return nil
}
stamp_version :: proc() -> Error {
    tag := b.env("BUNDLR_RELEASE_TAG")
    if !strings.has_prefix(tag, "v") || !b.regex_match(`^v[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$`, tag) { return "Invalid BUNDLR_RELEASE_TAG." }
    path := "src/common.odin"
    source := b.text(path) or_return
    newline := "\r\n" if strings.contains(source, "\r\n") else "\n"
    old := fmt.aprintf("%sVERSION :: \"%s\"%s", newline, b.VERSION, newline)
    if strings.count(source, old) != 1 { return "Cannot locate the Odin version constant." }
    replaced := b.replace(source, old, fmt.aprintf("%sVERSION :: \"%s\"%s", newline, tag[1:], newline))
    stage := t.temporary("src", ".version-") or_return
    defer os.remove_all(stage)
    candidate := b.join(stage, "common.odin")
    if e := b.write_text(candidate, replaced); e != nil { return e }
    if os.rename(candidate, path) != nil { return "Cannot stamp release checkout." }
    return nil
}
