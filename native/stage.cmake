file(MAKE_DIRECTORY "${STAGE}" "${STAGE}/licenses")
file(GLOB libraries "${PREFIX}/lib/*.so*" "${PREFIX}/lib/*.dylib" "${PREFIX}/bin/*.dll")
if(NOT libraries)
  message(FATAL_ERROR "No pinned shared libraries were built")
endif()
file(COPY ${libraries} DESTINATION "${STAGE}" FOLLOW_SYMLINK_CHAIN)
file(COPY "${LLHTTP_SHARED}" DESTINATION "${STAGE}")
if(WIN32)
  foreach(pair "libcurl.dll|curl.dll" "libarchive.dll|archive.dll" "libuv.dll|uv.dll")
    string(REPLACE "|" ";" names "${pair}")
    list(GET names 0 source)
    list(GET names 1 destination)
    if(EXISTS "${STAGE}/${source}" AND NOT EXISTS "${STAGE}/${destination}")
      file(COPY_FILE "${STAGE}/${source}" "${STAGE}/${destination}")
    endif()
  endforeach()
endif()
file(GLOB staged "${STAGE}/*.so*" "${STAGE}/*.dylib" "${STAGE}/*.dll")
if(UNIX AND NOT APPLE)
  find_program(PATCHELF patchelf REQUIRED)
  foreach(library IN LISTS staged)
    if(NOT IS_SYMLINK "${library}")
      execute_process(COMMAND "${PATCHELF}" --set-rpath "$ORIGIN" "${library}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
  endforeach()
elseif(APPLE)
  foreach(library IN LISTS staged)
    if(NOT IS_SYMLINK "${library}")
      get_filename_component(name "${library}" NAME)
      execute_process(COMMAND install_name_tool -id "@loader_path/${name}" "${library}" COMMAND_ERROR_IS_FATAL ANY)
      execute_process(COMMAND otool -L "${library}" OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
      string(REPLACE "\n" ";" linked "${linked}")
      foreach(line IN LISTS linked)
        string(REGEX MATCH "^[ \t]+([^ \t]+)" match "${line}")
        set(dependency "${CMAKE_MATCH_1}")
        get_filename_component(dependency_name "${dependency}" NAME)
        if(dependency AND EXISTS "${STAGE}/${dependency_name}")
          execute_process(COMMAND install_name_tool -change "${dependency}" "@loader_path/${dependency_name}" "${library}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
      endforeach()
      execute_process(COMMAND codesign --force --sign - "${library}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
  endforeach()
endif()
file(GLOB ports LIST_DIRECTORIES TRUE "${PREFIX}/share/*")
foreach(port IN LISTS ports)
  if(EXISTS "${port}/copyright")
    get_filename_component(name "${port}" NAME)
    file(COPY_FILE "${port}/copyright" "${STAGE}/licenses/${name}.txt")
  endif()
endforeach()
file(READ "${PROJECT_ROOT}/build-lock.json" lock)
string(JSON baseline GET "${lock}" vcpkgBaseline)
if(TRIPLET STREQUAL "bundlr-x64-linux")
  set(target "linux-x86_64")
elseif(TRIPLET STREQUAL "bundlr-x64-windows")
  set(target "windows-x86_64")
elseif(TRIPLET STREQUAL "bundlr-arm64-osx")
  set(target "macos-arm64")
elseif(TRIPLET STREQUAL "bundlr-x64-osx")
  set(target "macos-x86_64")
else()
  message(FATAL_ERROR "Unknown Bundlr triplet: ${TRIPLET}")
endif()
set(inventory "")
foreach(library IN LISTS staged)
  get_filename_component(name "${library}" NAME)
  file(SHA256 "${library}" digest)
  if(inventory)
    string(APPEND inventory ",")
  endif()
  string(APPEND inventory "\n    {\"name\": \"${name}\", \"sha256\": \"${digest}\"}")
endforeach()
file(WRITE "${STAGE}/native-dependencies.json" "{\n  \"vcpkgBaseline\": \"${baseline}\",\n  \"target\": \"${target}\",\n  \"libraries\": [${inventory}\n  ]\n}\n")
